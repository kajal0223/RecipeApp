<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:ignore="ExtraText">

    <!-- Top Header Section: Back Button, Title, and Profile Badge -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@color/top_bar"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_back_my_recipes"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back to profile"
                android:src="@drawable/ic_chevron_left"
                app:tint="#2D2013" />

            <TextView
                android:id="@+id/tv_my_recipes_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Recipes"
                android:textColor="#2D2013"
                android:textSize="26sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Profile Circle Badge -->
        <TextView
            android:id="@+id/tv_profile_badge"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/circle_background"
            android:gravity="center"
            android:textColor="#2D2013"
            android:textSize="14sp"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_my_recipes_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 Recipes"
                android:textColor="@color/text_light"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_my_recipe"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Add Recipe"
                android:textAllCaps="false"
                android:textColor="@color/orange_dark"
                app:backgroundTint="@color/orange_light"
                app:cornerRadius="20dp"
                app:elevation="0dp" />

        </LinearLayout>

        <!-- Empty State -->
        <TextView
            android:id="@+id/tv_empty_my_recipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:padding="20dp"
            android:text="No recipes yet. Tap + Add Recipe to create your first one."
            android:textColor="@color/text_light"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Recipe List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_my_recipes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="20dp" />

    </LinearLayout>

</LinearLayout>