<?xml version="1.0" encoding="utf-8"?>
<!-- Card row layout for a recipe in MyRecipesAdapter with edit and delete actions -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/card_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Recipe title, metadata summary, and ingredient preview -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_item_recipe_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe Title"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_item_recipe_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Dinner · 20 min · 2 servings"
            android:textColor="@color/text_light"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_item_recipe_ingredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Ingredients: eggs, rice, soy sauce"
            android:textColor="@color/text_light"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Row edit and delete action buttons -->
    <ImageButton
        android:id="@+id/btn_edit_recipe"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Edit recipe"
        android:src="@drawable/ic_edit"
        app:tint="@color/text_dark" />

    <ImageButton
        android:id="@+id/btn_delete_recipe"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete recipe"
        android:src="@drawable/ic_delete"
        app:tint="@color/orange_dark" />

</LinearLayout>