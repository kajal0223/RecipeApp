<?xml version="1.0" encoding="utf-8"?>
<!-- Form layout for adding or editing a recipe inside AddRecipeDialog -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Recipe photo preview and picker button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_recipe_preview"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_badge_orange"
                android:contentDescription="Recipe photo preview"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_recipes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pick_recipe_image"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Choose Photo"
                android:textAllCaps="false"
                android:textColor="@color/orange_dark"
                app:cornerRadius="16dp"
                app:strokeColor="@color/card_outlines" />
        </LinearLayout>

        <!-- Basic recipe metadata: title, category, prep time, and servings -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Title *"
            android:textColor="@color/text_dark"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_recipe_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="e.g., Egg Fried Rice"
            android:inputType="textCapWords" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Category *"
            android:textColor="@color/text_dark"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/sp_recipe_category"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Prep Time (min) *"
                    android:textColor="@color/text_dark"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_recipe_prep_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="20"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Servings *"
                    android:textColor="@color/text_dark"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_recipe_servings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="2"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <!-- Ingredients, step-by-step instructions, and optional notes -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Ingredients (comma or new line separated) *"
            android:textColor="@color/text_dark"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_recipe_ingredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="top"
            android:hint="e.g., Eggs, Rice, Soy Sauce"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Instructions (one step per line) *"
            android:textColor="@color/text_dark"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_recipe_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="top"
            android:hint="Step 1: Cook rice&#10;Step 2: Scramble eggs"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Notes (optional)"
            android:textColor="@color/text_dark"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_recipe_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Optional tips or variations"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2" />

    </LinearLayout>
</ScrollView>